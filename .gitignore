# Generated boards (CI rebuilds with --force)
examples/**/layout/
# Same for the fixture boards a test builds: every test copies one to tmp_path first, so this only
# catches a `pcbc build` somebody ran by hand in the tree.
tests/fixtures/**/layout/

**/review/index.html
**/review/board.glb
**/review/*.svg
**/review/sch/
**/review/silk.kicad_*
**/review/schematic.pdf
**/review/schematic.kicad_sch
**/review/report.json
**/routed/0[0-9]_*.kicad_*
**/placed/*.preseed.*
**/layout.log
**/fab/*-drl_map.pdf
**/fab/drc.json
**/fab/pos_kicad.csv
**/fab/report.json

# Example parts keep their STEP models out of git (megabytes each); pcbc fetch restores them
examples/**/*.step
examples/**/*.wrl

# Picture differences Vibes draws for a pull request. The committed sheets live
# under tests/benchmarks/schematics/.
vibes-images/
